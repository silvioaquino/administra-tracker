# ============================================================
# Variáveis de ambiente — configure estas na Vercel
# (Project Settings → Environment Variables)
# ============================================================

# Banco NeonDB (use a connection string com -pooler para serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# NextAuth
# Em produção, use a URL pública do deploy (NÃO localhost):
NEXTAUTH_URL="https://seu-app.vercel.app"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="troque-por-um-secret-forte"

# Senha padrão usada pelo seed (apenas para popular contas iniciais)
SEED_PASSWORD="admin123"
